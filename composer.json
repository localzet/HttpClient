{
  "name": "localzet/http",
  "description": "Asynchronous HTTP requests and connection pooling for Localzet Server.",
  "type": "library",
  "keywords": [
    "HTTP",
    "client",
    "PHP",
    "library",
    "localzet",
    "AGPL",
    "curl",
    "json",
    "psr7",
    "server"
  ],
  "license": "AGPL-3.0-or-later",
  "authors": [
    {
      "role": "Developer",
      "name": "Ivan Zorin",
      "email": "creator@localzet.com",
      "homepage": "https://github.com/localzet"
    }
  ],
  "support": {
    "email": "support@localzet.com",
    "issues": "https://github.com/localzet/HttpClient/issues",
    "source": "https://github.com/localzet/HttpClient"
  },
  "require": {
    "php": "^8.2",
    "ext-curl": "*",
    "ext-json": "*",
    "localzet/server": "^7.0",
    "localzet/psr7": "^4.0",
    "psr/http-message": "^2.0"
  },
  "autoload": {
    "psr-4": {
      "localzet\\HTTP\\": "src/"
    }
  },
  "scripts": {
    "test": "php tests/regression.php",
    "test:integration": "php tests/integration.php",
    "lint": "find . -name '*.php' -not -path './vendor/*' -print0 | xargs -0 -n1 php -l"
  }
